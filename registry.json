{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ada",
  "homepage": "https://github.com/mesbahismail/Ada",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Ada Theme",
      "description": "Fuchsia/plum light & dark theme with gradient backdrop, glow and bubble tokens.",
      "dependencies": [
        "tw-animate-css"
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-heading)",
          "color-surface": "var(--surface)",
          "color-surface-foreground": "var(--surface-foreground)",
          "color-bubble": "var(--bubble)",
          "color-bubble-foreground": "var(--bubble-foreground)",
          "animate-wave": "wave 1.1s ease-in-out infinite"
        },
        "light": {
          "radius": "0.75rem",
          "background": "oklch(0.955 0.018 315)",
          "foreground": "oklch(0.22 0.06 315)",
          "card": "oklch(1 0 0 / 70%)",
          "card-foreground": "oklch(0.22 0.06 315)",
          "popover": "oklch(0.99 0.006 315)",
          "popover-foreground": "oklch(0.22 0.06 315)",
          "primary": "oklch(0.58 0.27 320)",
          "primary-foreground": "oklch(0.99 0.005 320)",
          "secondary": "oklch(0.35 0.12 315 / 7%)",
          "secondary-foreground": "oklch(0.25 0.07 315)",
          "muted": "oklch(0.35 0.12 315 / 6%)",
          "muted-foreground": "oklch(0.5 0.05 315)",
          "accent": "oklch(0.58 0.27 320 / 10%)",
          "accent-foreground": "oklch(0.3 0.12 318)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.35 0.12 315 / 13%)",
          "input": "oklch(0.35 0.12 315 / 16%)",
          "ring": "oklch(0.58 0.27 320 / 55%)",
          "chart-1": "oklch(0.58 0.27 320)",
          "chart-2": "oklch(0.52 0.24 300)",
          "chart-3": "oklch(0.7 0.18 330)",
          "chart-4": "oklch(0.45 0.18 290)",
          "chart-5": "oklch(0.8 0.1 320)",
          "sidebar": "oklch(1 0 0 / 40%)",
          "sidebar-foreground": "oklch(0.28 0.06 315)",
          "sidebar-primary": "oklch(0.58 0.27 320)",
          "sidebar-primary-foreground": "oklch(0.99 0.005 320)",
          "sidebar-accent": "oklch(0.35 0.12 315 / 7%)",
          "sidebar-accent-foreground": "oklch(0.22 0.06 315)",
          "sidebar-border": "oklch(0.35 0.12 315 / 10%)",
          "sidebar-ring": "oklch(0.58 0.27 320 / 55%)",
          "surface": "oklch(1 0 0 / 55%)",
          "surface-foreground": "oklch(0.22 0.06 315)",
          "bubble": "oklch(0.58 0.27 320)",
          "bubble-foreground": "oklch(0.99 0.005 320)",
          "backdrop": "radial-gradient(90% 70% at 90% 105%, oklch(0.8 0.15 318 / 70%) 0%, transparent 65%), radial-gradient(60% 50% at 0% 0%, oklch(0.93 0.05 300 / 90%) 0%, transparent 70%), linear-gradient(160deg, oklch(0.97 0.012 315) 0%, oklch(0.92 0.04 318) 100%)",
          "bubble-gradient": "linear-gradient(135deg, oklch(0.62 0.27 322) 0%, oklch(0.54 0.26 308) 100%)",
          "orb-gradient": "radial-gradient(circle at 35% 30%, oklch(0.78 0.2 320) 0%, oklch(0.6 0.28 318) 45%, oklch(0.42 0.22 300) 100%)",
          "glow": "0 0 40px 4px oklch(0.6 0.28 320 / 40%), 0 0 90px 20px oklch(0.6 0.28 320 / 18%)"
        },
        "dark": {
          "background": "oklch(0.13 0.025 315)",
          "foreground": "oklch(0.96 0.012 320)",
          "card": "oklch(0.26 0.06 318 / 50%)",
          "card-foreground": "oklch(0.96 0.012 320)",
          "popover": "oklch(0.19 0.045 316)",
          "popover-foreground": "oklch(0.96 0.012 320)",
          "primary": "oklch(0.62 0.28 320)",
          "primary-foreground": "oklch(0.99 0.005 320)",
          "secondary": "oklch(1 0 0 / 7%)",
          "secondary-foreground": "oklch(0.94 0.015 320)",
          "muted": "oklch(1 0 0 / 6%)",
          "muted-foreground": "oklch(0.74 0.04 315)",
          "accent": "oklch(1 0 0 / 8%)",
          "accent-foreground": "oklch(0.96 0.012 320)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 9%)",
          "input": "oklch(1 0 0 / 12%)",
          "ring": "oklch(0.62 0.28 320 / 60%)",
          "chart-1": "oklch(0.62 0.28 320)",
          "chart-2": "oklch(0.55 0.25 300)",
          "chart-3": "oklch(0.72 0.19 330)",
          "chart-4": "oklch(0.48 0.2 290)",
          "chart-5": "oklch(0.82 0.1 320)",
          "sidebar": "oklch(0.11 0.025 315 / 55%)",
          "sidebar-foreground": "oklch(0.88 0.02 318)",
          "sidebar-primary": "oklch(0.62 0.28 320)",
          "sidebar-primary-foreground": "oklch(0.99 0.005 320)",
          "sidebar-accent": "oklch(1 0 0 / 7%)",
          "sidebar-accent-foreground": "oklch(0.96 0.012 320)",
          "sidebar-border": "oklch(1 0 0 / 8%)",
          "sidebar-ring": "oklch(0.62 0.28 320 / 60%)",
          "surface": "oklch(0.2 0.045 316 / 55%)",
          "surface-foreground": "oklch(0.96 0.012 320)",
          "bubble": "oklch(0.62 0.28 320)",
          "bubble-foreground": "oklch(0.99 0.005 320)",
          "backdrop": "radial-gradient(90% 70% at 90% 105%, oklch(0.42 0.22 318 / 75%) 0%, transparent 65%), radial-gradient(60% 50% at 0% 0%, oklch(0.26 0.1 300 / 45%) 0%, transparent 70%), linear-gradient(160deg, oklch(0.14 0.03 315) 0%, oklch(0.17 0.06 318) 100%)",
          "bubble-gradient": "linear-gradient(135deg, oklch(0.62 0.28 322) 0%, oklch(0.52 0.26 308) 100%)",
          "orb-gradient": "radial-gradient(circle at 35% 30%, oklch(0.78 0.2 320) 0%, oklch(0.6 0.28 318) 45%, oklch(0.38 0.2 300) 100%)",
          "glow": "0 0 40px 6px oklch(0.6 0.28 320 / 55%), 0 0 110px 30px oklch(0.6 0.28 320 / 25%)"
        }
      },
      "css": {
        "@keyframes wave": {
          "0%, 100%": {
            "transform": "scaleY(0.35)"
          },
          "50%": {
            "transform": "scaleY(1)"
          }
        },
        "@utility bg-backdrop": {
          "background-color": "var(--background)",
          "background-image": "var(--backdrop)",
          "background-attachment": "fixed"
        },
        "@utility bg-bubble-gradient": {
          "background-image": "var(--bubble-gradient)"
        },
        "@utility bg-orb": {
          "background-image": "var(--orb-gradient)"
        },
        "@utility shadow-glow": {
          "box-shadow": "var(--glow)"
        },
        "@layer base": {
          "body": {
            "background-image": "var(--backdrop)",
            "background-attachment": "fixed"
          }
        }
      },
      "categories": [
        "theme"
      ]
    },
